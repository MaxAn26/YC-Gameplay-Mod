<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>YC.Unloader</RootNamespace>
		<AssemblyName>YC.Unloader</AssemblyName>
		<Description>YC Unloader</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LavaGang.MelonLoader" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BaseMod.Core\BaseMod.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>..\Libs\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>..\Libs\Il2CppInterop.Runtime.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>..\Libs\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>..\Libs\Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\Libs\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<PropertyGroup>
			<OutBaseDir>..\@Mods\</OutBaseDir>
			<OutModsDir>$(OutBaseDir)Mods\</OutModsDir>
			<OutUserLibsDir>$(OutBaseDir)UserLibs\</OutUserLibsDir>
			<OutUserDataDir>$(OutBaseDir)UserData\$(AssemblyName)\</OutUserDataDir>
		</PropertyGroup>

		<ItemGroup>
			<ModDll Include="$(TargetDir)$(TargetFileName)" />
			<UserLibs Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetFileName)" />
		</ItemGroup>

		<MakeDir Directories="$(OutModsDir)" />
		<MakeDir Directories="$(OutUserLibsDir)" />

		<RemoveDir Directories="$(OutUserDataDir)" />
		<MakeDir Directories="$(OutUserDataDir)" />

		<Copy SourceFiles="@(ModDll)" DestinationFolder="$(OutModsDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(UserLibs)" DestinationFolder="$(OutUserLibsDir)" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="PostPublish" AfterTargets="Publish" Condition="'$(Configuration)'=='Release'">
		<PropertyGroup>
			<OutReleaseDir>..\@Release\</OutReleaseDir>
			<OutBaseDir>$(OutReleaseDir)$(AssemblyName)\</OutBaseDir>
			<OutModsDir>$(OutBaseDir)Mods\</OutModsDir>
			<OutUserLibsDir>$(OutBaseDir)UserLibs\</OutUserLibsDir>
			<OutUserDataDir>$(OutBaseDir)UserData\$(AssemblyName)\</OutUserDataDir>
		</PropertyGroup>

		<ItemGroup>
			<ModDll Include="$(TargetDir)$(TargetFileName)" />
			<UserLibs Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetFileName)" />
			<ReadmeFiles Include="$(ProjectDir)$(TargetName)_Readme.*" />
		</ItemGroup>

		<RemoveDir Directories="$(OutBaseDir)" />
		<MakeDir Directories="$(OutModsDir)" />
		<MakeDir Directories="$(OutUserLibsDir)" />
		<MakeDir Directories="$(OutUserDataDir)" />

		<Copy SourceFiles="@(ModDll)" DestinationFolder="$(OutModsDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(UserLibs)" DestinationFolder="$(OutUserLibsDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(ReadmeFiles)" DestinationFolder="$(OutBaseDir)" />

		<ZipDirectory SourceDirectory="$(OutBaseDir)" DestinationFile="$(SolutionDir)@Release\$(AssemblyName)-$(AssemblyVersion).zip" Overwrite="true" />
	</Target>
</Project>