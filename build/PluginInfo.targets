<Project>
<Target Name="GenerateMyPluginInfo" BeforeTargets="BeforeCompile">
	<!-- Путь к файлу -->
	<PropertyGroup>
		<GeneratedFile>$(IntermediateOutputPath)MyPluginInfo.cs</GeneratedFile>
	</PropertyGroup>

	<!-- Запись содержимого -->
	<WriteLinesToFile File="$(GeneratedFile)"
					  Overwrite="true"
					  Lines="using System%3B
						internal static class MyPluginInfo {
							public const string PLUGIN_GUID = &quot;$(AssemblyName)&quot;%3B
							public const string PLUGIN_NAME = &quot;$(Product)&quot;%3B
							public const string PLUGIN_VERSION = &quot;$(Version)&quot;%3B
							public const string PLUGIN_AUTHORS = &quot;$(Authors)&quot;%3B
						}"
					  />

	<!-- Подключаем файл к компиляции -->
	<ItemGroup>
		<Compile Include="$(GeneratedFile)" />
	</ItemGroup>
</Target>
</Project>